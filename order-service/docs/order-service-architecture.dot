// AI-INFLUENCED: Order Service architecture diagram drawn with Codex from the implemented code and supplied course materials.
digraph OrderServiceArchitecture {
  graph [
    label="Order Service architecture | implemented component view (C4 level 3)",
    labelloc=t, labeljust=l, fontsize=22, fontname="Helvetica-Bold",
    fontcolor="#14243a", bgcolor="white", pad=0.35, rankdir=TB,
    compound=true, newrank=true, splines=polyline, nodesep=0.32, ranksep=0.58
  ];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11,
        color="#4c7180", fillcolor="#e8f4ef", fontcolor="#14243a", margin="0.18,0.12"];
  edge [fontname="Helvetica", fontsize=9, color="#345d76", fontcolor="#28475c", arrowsize=0.7, penwidth=1.25];

  users [label="Requester / courier\nweb client", fillcolor="#e9f1fb", color="#678dbd"];
  gateway [label="API Gateway\nJWT validation; trusted identity headers", fillcolor="#e9f1fb", color="#678dbd"];
  supplier [label="Supplier Service API\nsupplier details and category search", fillcolor="#e9f1fb", color="#678dbd"];
  credit [label="Credit Service (supplied zip)\nreservation API; order-event consumer;\ncredit-event publisher", fillcolor="#e9f1fb", color="#678dbd"];

  subgraph cluster_order {
    label="Order Service | FastAPI / Python 3.12 :8000";
    labelloc=t; labeljust=l; fontsize=16; fontname="Helvetica-Bold";
    color="#4a8a71"; bgcolor="#f8fcf9"; style="rounded"; penwidth=1.7;

    api [label="HTTP interface\napi/routes/orders.py + health.py\nrequest validation, identity/role checks, responses"];
    workflow [label="Order workflows\nservices/orders.py\ncreate, query, update, accept, pickup,\nwithdraw, deliver, cancel, delete, approve"];
    lifecycle [label="Lifecycle policy\nservices/lifecycle.py\nseven statuses; allowed transitions", fillcolor="#d9eee1"];
    http_adapters [label="Outbound HTTP clients\nclients/supplier + clients/credit\nhttpx transport and response contracts", fillcolor="#e6f3f7"];
    timed [label="Timed workers\nexpiry_worker.py (5 s)\nauto_approval_worker.py (60 s)", fillcolor="#fff2dc", color="#ba8c49"];
    results [label="Credit-result consumers / handlers\nrelease, update, approval consumers\ncorrelate task + reservation; apply outcome", fillcolor="#fff2dc", color="#ba8c49"];
    repos [label="Persistence repositories\norders + request, release, update,\napproval-task and event-outbox repositories"];
    relay [label="Event relay\nevent_worker.py + events.py\nconfirmed, persistent AMQP publish; retry", fillcolor="#fff2dc", color="#ba8c49"];

    api -> workflow [label="calls / validated JSON"];
    workflow -> lifecycle [label="checks legal status changes"];
    workflow -> http_adapters [label="calls remote APIs"];
    workflow -> repos [label="reads / transactional writes"];
    timed -> lifecycle [label="checks transitions"];
    timed -> repos [label="locks due orders; writes status + facts"];
    results -> lifecycle [label="checks transitions"];
    results -> repos [label="locks tasks + orders; writes outcomes"];
    relay -> repos [label="reads pending outbox; records delivery"];
  }

  db [shape=cylinder, style=filled, label="order-db | PostgreSQL\norders; order_requests; release, update,\napproval tasks; order_event_outbox", fillcolor="#eef0f3", color="#778390"];
  order_x [label="foc.order.events\nRabbitMQ topic exchange\norder-local facts", fillcolor="#fceecb", color="#bd943d"];
  credit_x [label="foc.credit.events\nRabbitMQ topic exchange\ncredit-local facts", fillcolor="#fceecb", color="#bd943d"];
  gap [shape=note, style="filled,dashed", label="Integration gap in supplied credit zip:\nno OrderApprovalRequested binding; no\nCreditTransferSucceeded / Failed publisher.\nIt binds OrderCompleted, which Order does not emit.", fillcolor="#f8ecf5", color="#a76c99", fontsize=10];
  legend [shape=note, style=filled, label="Legend\nBlue/green solid arrow = synchronous call or local control\nOrange dashed arrow = AMQP event flow\nGrey dotted arrow = database access\nPurple dashed note = contract gap, not a working flow\nCylinder = service-owned data store", fillcolor="#f6f7f9", color="#9aa4ae", fontsize=10];

  users -> gateway [label="HTTPS / JSON + bearer token"];
  gateway -> api [label="HTTP / JSON; X-User-Id, X-User-Role"];
  http_adapters -> supplier [label="HTTP GET /suppliers/{id}; GET /suppliers\nvalidate creation / filter category"];
  http_adapters -> credit [label="HTTP POST /credits/reservations\nreserve on creation; release on DB failure"];
  repos -> db [label="SQLAlchemy / asyncpg", style=dotted, color="#778390", fontcolor="#626c76"];
  relay -> order_x [label="AMQP publish; routing key = event type", style=dashed, color="#b47a21", fontcolor="#805716"];
  order_x -> credit [label="AMQP consume: delete/cancel/update requests,\nOrderExpired, CourierWithdrawn", style=dashed, color="#b47a21", fontcolor="#805716"];
  credit -> credit_x [label="AMQP publish: release/amend outcomes\n(+ reservation facts)", style=dashed, color="#b47a21", fontcolor="#805716"];
  credit_x -> results [label="AMQP consume: CreditReleased / Failed;\nCreditAmended / Rejected", style=dashed, color="#b47a21", fontcolor="#805716"];
}
