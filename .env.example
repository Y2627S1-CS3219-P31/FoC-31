# ─────────────────────────────────────────────────────────────
# FoC — Friend on Campus · Environment configuration (EXAMPLE)
# ─────────────────────────────────────────────────────────────
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is git-ignored — NEVER commit real secrets.
# Any variable read by any service MUST appear here with a safe
# placeholder so teammates know what to set.
#
# This is just an example; you can add more variables as needed.
# ─────────────────────────────────────────────────────────────

# ---- Global -------------------------------------------------
LOG_LEVEL=info

# ---- Auth / JWT --------------------------------------------
# Shared signing secret used by user-service (issue) and
# api-gateway (validate). Use a long random value in real envs.
JWT_SECRET=change-me-in-dev-only
JWT_ACCESS_TOKEN_TTL=3600        # seconds (backlog N1.3: 60 min session)
JWT_REFRESH_TOKEN_TTL=86400      # seconds

# ---- Credit economy ----------------------------------------
INITIAL_CREDIT_ALLOCATION=100    # backlog Credit F1.1.1

# ---- API Gateway -------------------------------------------
# Internal (docker-network) URLs of the backend services the
# gateway reverse-proxies to. Hostnames match compose service names.
GATEWAY_PORT=8080
USER_SERVICE_URL=http://user-service:8000
SUPPLIER_SERVICE_URL=http://supplier-service:8000
ORDER_SERVICE_URL=http://order-service:8000
CREDIT_SERVICE_URL=http://credit-service:8000
NOTIFICATION_SERVICE_URL=http://notification-service:8000

# ---- Message broker (RabbitMQ) -----------------------------
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
ORDER_EVENTS_EXCHANGE=foc.order.events
USER_EVENTS_EXCHANGE=foc.events
CREDIT_EVENTS_EXCHANGE=foc.credit.events

# ---- Databases (one Postgres per service) ------------------
# Each service owns its own database (DB-per-service pattern).
POSTGRES_USER=foc
POSTGRES_PASSWORD=foc
# user-service DB
USER_DB_NAME=user_db
USER_DATABASE_URL=postgresql+asyncpg://foc:foc@user-db:5432/user_db
# supplier-service DB
SUPPLIER_DB_NAME=supplier_db
SUPPLIER_DATABASE_URL=postgresql+asyncpg://foc:foc@supplier-db:5432/supplier_db
# order-service DB
ORDER_DB_NAME=order_db
ORDER_DATABASE_URL=postgresql+asyncpg://foc:foc@order-db:5432/order_db
# credit-service DB
CREDIT_DB_NAME=credit_db
CREDIT_DATABASE_URL=postgresql+asyncpg://foc:foc@credit-db:5432/credit_db
# notification-service DB
NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DATABASE_URL=postgresql+asyncpg://foc:foc@notification-db:5432/notification_db

# ---- Frontend ----------------------------------------------
# Base URL the SPA uses to reach the API gateway (from the browser).
VITE_API_BASE_URL=http://localhost:8080

# ... Add more variables as needed
