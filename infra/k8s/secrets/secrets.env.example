# Copy to secrets.env (gitignored) and source before running secrets.template.sh,
# or point SECRETS_ENV at it for seal-secrets.sh. NEVER commit this file.
# Passwords left unset are generated; seal-secrets.sh writes generated values
# back here so re-runs are deterministic and never rotate a live DB password.
# The S3 backup bucket now comes from values-ec2.yaml via render-ec2-values.sh,
# not from here.

PG_USER=foc
RABBITMQ_USER=foc

# Optional overrides (uncomment to pin a value):
# JWT_SECRET=
# RABBITMQ_PASSWORD=
# SUPPLIER_PG_PASSWORD=
# USER_PG_PASSWORD=
# CREDIT_PG_PASSWORD=
# ORDER_PG_PASSWORD=
# NOTIFICATION_PG_PASSWORD=

# Static backup creds: LOCAL mode only (e.g. local MinIO). On EC2 the instance
# role provides creds via IMDS and seal-secrets.sh skips these entirely.
# BACKUP_AWS_ACCESS_KEY_ID=
# BACKUP_AWS_SECRET_ACCESS_KEY=
