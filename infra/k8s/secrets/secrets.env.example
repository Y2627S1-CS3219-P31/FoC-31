# Example environment for infra/k8s/secrets/secrets.template.sh.
# Copy to secrets.env (gitignored) and `source` it, or export these directly,
# before running the script. NEVER commit real values.

# Postgres role shared by the DB containers and the service DATABASE_URLs.
PG_USER=foc

# Leave passwords UNSET to auto-generate on first run and reuse thereafter.
# Set a value only to pin it (e.g. to match an existing database).
# SUPPLIER_PG_PASSWORD=

# Phase B will add, for example:
# JWT_SECRET=
# RABBITMQ_USER=
# RABBITMQ_PASSWORD=
# USER_PG_PASSWORD=
# CREDIT_PG_PASSWORD=
