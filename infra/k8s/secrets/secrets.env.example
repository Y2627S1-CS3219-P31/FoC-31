# Copy to secrets.env (gitignored) and source before running secrets.template.sh.
# NEVER commit real values. Passwords left unset are generated and reused.

PG_USER=foc
RABBITMQ_USER=foc

# Optional overrides:
# JWT_SECRET=
# RABBITMQ_PASSWORD=
# SUPPLIER_PG_PASSWORD=
# USER_PG_PASSWORD=
# CREDIT_PG_PASSWORD=

# Backup creds: only for non-IMDS use (e.g. local MinIO). On AWS the instance
# role provides creds. Set the bucket via helm global.backup.bucket, not here.
# BACKUP_AWS_ACCESS_KEY_ID=
# BACKUP_AWS_SECRET_ACCESS_KEY=
